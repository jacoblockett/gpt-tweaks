{
  "manifest_version": 3,
  "name": "GPT Tweaks",
  "version": "1.0.0",
  "description": "UI and UX tweaks to ChatGPT's online web interface.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "Open GPT Tweaks settings",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "background": {
    "service_worker": "chrome/background.js"
  },
  "options_page": "settings/index.html",
  "host_permissions": [
    "https://api.github.com/*",
    "https://codeload.github.com/*",
    "https://github.com/login/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "shared/conversation/content.js",
        "shared/conversation/history.js",
        "utilities/token-estimator/estimator-core.js",
        "utilities/token-estimator/history-bridge.js",
        "utilities/session-handoff/stream-bridge.js",
        "utilities/message-timestamps/stream-bridge.js",
        "utilities/enhanced-copy/history-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "shared/ui/feature-registry.js",
        "utilities/github-source/ui/scrollbar.js",
        "shared/ui/select.js",
        "utilities/github-source/ui/revisions.js",
        "utilities/github-source/attachment.js",
        "utilities/github-source/ui/modal.js",
        "utilities/github-source/index.js"
      ],
      "css": [
        "shared/ui/select.css",
        "utilities/github-source/ui/styles.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "shared/conversation/content.js",
        "utilities/token-estimator/estimator-core.js",
        "utilities/token-estimator/storage.js",
        "utilities/token-estimator/ui/indicator.js",
        "utilities/token-estimator/index.js",
        "utilities/new-chat/index.js",
        "utilities/session-handoff/ui/toast.js",
        "utilities/session-handoff/ui/model-confirmation.js",
        "utilities/session-handoff/index.js",
        "utilities/session-handoff/ui/menu.js",
        "utilities/enhanced-copy/index.js",
        "utilities/enhanced-copy/ui/menu.js",
        "utilities/message-timestamps/index.js",
        "utilities/header-menu/index.js"
      ],
      "css": [
        "utilities/token-estimator/ui/styles.css",
        "utilities/session-handoff/ui/toast.css",
        "utilities/enhanced-copy/ui/toast.css",
        "utilities/header-menu/styles.css",
        "utilities/message-timestamps/styles.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/gpt-tweaks.svg"
      ],
      "matches": [
        "https://chatgpt.com/*"
      ]
    }
  ]
}
