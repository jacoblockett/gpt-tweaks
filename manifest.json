{
  "manifest_version": 3,
  "name": "GPT Tweaks",
  "version": "1.0.0",
  "description": "UI and UX tweaks to ChatGPT's online web interface.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Open GPT Tweaks settings"
  },
  "background": {
    "service_worker": "chrome/background.js"
  },
  "options_page": "settings/index.html",
  "host_permissions": [
    "https://api.github.com/*",
    "https://codeload.github.com/*",
    "https://github.com/login/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "utilities/token-estimator/estimator-core.js",
        "utilities/token-estimator/history-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "shared/ui/menus/core.js",
        "shared/ui/menus/plus.js",
        "shared/ui/menus/slash.js",
        "utilities/github-source/ui/scrollbar.js",
        "shared/ui/select.js",
        "utilities/github-source/ui/revisions.js",
        "utilities/github-source/attachment.js",
        "utilities/github-source/ui/modal.js",
        "utilities/github-source/index.js"
      ],
      "css": [
        "shared/ui/select.css",
        "shared/ui/menus/styles.css",
        "utilities/github-source/ui/styles.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "utilities/token-estimator/estimator-core.js",
        "utilities/token-estimator/storage.js",
        "utilities/token-estimator/ui/indicator.js",
        "utilities/token-estimator/index.js",
        "utilities/token-estimator/menu.js",
        "utilities/new-chat/index.js",
        "utilities/new-chat/ui/menu.js"
      ],
      "css": [
        "utilities/token-estimator/ui/styles.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ]
}
