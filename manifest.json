{
  "manifest_version": 3,
  "name": "GPT Tweaks",
  "version": "1.0.0",
  "description": "UI and UX tweaks to ChatGPT's online web interface.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Open GPT Tweaks settings"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "website/index.html"
}
